# Copy this file to .env and adjust as needed. .env is gitignored.

POSTGRES_DB=ledgerflow

# The owning role: Flyway runs migrations as this user and it owns the tables.
POSTGRES_USER=ledgerflow
POSTGRES_PASSWORD=change-me

# The role the application connects as at runtime. Deliberately separate and
# not a superuser -- superusers bypass row-level security, which would make
# the tenant isolation policies in V10 decorative. Created by that migration,
# which reads this password as a Flyway placeholder.
POSTGRES_APP_USER=ledgerflow_app
POSTGRES_APP_PASSWORD=app-change-me

# The third role, created by V11. It bypasses row-level security so the
# outbox poller can read every organization's events in one query, and is
# granted nothing beyond SELECT and UPDATE on outbox_event. Only the worker
# container is given these credentials.
POSTGRES_ADMIN_USER=ledgerflow_admin
POSTGRES_ADMIN_PASSWORD=admin-change-me

RABBITMQ_DEFAULT_USER=ledgerflow
RABBITMQ_DEFAULT_PASS=change-me

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
